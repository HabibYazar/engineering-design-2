# Ortam değişkeni şablonu — ABÜ KDS
#
# Kullanım:
#     cp .env.example .env
# ve GEMINI_API_KEY satırına kendi anahtarınızı yazın.
#
# BU DOSYAYA GERÇEK ANAHTAR YAZMAYIN. Teslim paketinde `.env` yoktur;
# anahtar yalnızca çalıştıran kişinin kendi makinesinde bulunur.

# --------------------------------------------------------------------------
# Veritabanı
# --------------------------------------------------------------------------
# Boş bırakılırsa uygulama backend klasöründeki university_management.db
# dosyasını kullanır. Teslim paketinde bu dosya hazır gelir.
DATABASE_URL=

# --------------------------------------------------------------------------
# Yapay Zeka Kokpiti — Google Gemini
# --------------------------------------------------------------------------
# Asistan YALNIZCA bu projenin kendi veritabanını okur; web araması yapmaz.
# Anahtar verilmezse uygulama ÇALIŞMAYA DEVAM EDER, yalnızca Yapay Zeka
# Kokpiti ekranı "sağlayıcı yapılandırılmadı" durumunu gösterir.
#
# Anahtar: https://aistudio.google.com/apikey
ASSISTANT_ENABLED=true
LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_KEY_HERE
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3-flash-preview

# Tek bir model çağrısının HTTP süre sınırı (saniye).
# Orkestrasyon katmanı bunu tur başına 25 sn ve kullanıcı mesajı başına
# toplam 45 sn ile ayrıca sınırlar.
GEMINI_TIMEOUT_SECONDS=120

# Yönetim raporlarında yaratıcılık değil tutarlılık istenir.
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_TOKENS=4096

# --------------------------------------------------------------------------
# Asistan sınırları
# --------------------------------------------------------------------------
ASSISTANT_MAX_MESSAGE_LENGTH=4000
ASSISTANT_MAX_CONVERSATIONS=100
ASSISTANT_MAX_HISTORY_MESSAGES=20

# Gemini 3 dusunme seviyesi: minimal | low | medium | high
# Bos birakilirsa model VARSAYILAN seviyeyi (medium, ~8192 token dusunme)
# uygular ve tum uretim butcesini cevabi hic yazmadan tuketebilir.
GEMINI_REASONING_EFFORT=low

# Merkezi veri tabani (SALT OKUNUR). Bos birakilirsa proje icinde
# data/abu_kds/abu_kds.db aranir. Mutlak yol yazmak gerekmez.
ABU_KDS_DB_PATH=

# Kota dolarsa denenecek ALTERNATIF BULUT modelleri (virgulle ayrilmis).
# Yalnizca Gemini bulut modelleri; projede yerel model YOKTUR.
# Bos birakilirsa alternatif denenmez, dogrudan eldeki veriden
# deterministik cevap uretilir.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash
