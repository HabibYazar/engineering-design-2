# Ortam değişkeni şablonu.
#
# Kullanım: bu dosyayı .env adıyla kopyalayın ve değerleri doldurun.
#     cp .env.example .env
#
# .env dosyası .gitignore içindedir ve Git deposuna GİRMEZ.
# Bu şablona GERÇEK bir API anahtarı veya parola yazmayın.

# --------------------------------------------------------------------------
# Veritabanı
# --------------------------------------------------------------------------
# Boş bırakılırsa uygulama backend klasöründeki SQLite dosyasını kullanır.
DATABASE_URL=

# --------------------------------------------------------------------------
# Akıllı asistan
# --------------------------------------------------------------------------
# Bu projede HİÇBİR dil modeli bağlı DEĞİLDİR. Aşağıdaki değişkenler yalnızca
# ileride bir model bağlanabilmesi için ayrılmış boş yerlerdir.
#
# ASSISTANT_ENABLED=true yapmak tek başına asistanı çalıştırmaz; ayrıca
# AssistantProvider arayüzünü uygulayan bir sağlayıcı sınıfı yazılmalıdır.
# Sağlayıcı yoksa sistem uydurma cevap üretmek yerine durumu açıkça bildirir.

ASSISTANT_ENABLED=false

# Sağlayıcı adı. Bu projede hiçbir sağlayıcı seçilmemiştir; karar ekibe aittir.
LLM_PROVIDER=

# Model adı. Var olmayan bir model adı yazmayın.
LLM_MODEL=

# API anahtarı. BURAYA GERÇEK ANAHTAR YAZMAYIN — bu dosya Git'e girer.
# Anahtarı yalnızca yerel .env dosyanıza yazın.
LLM_API_KEY=

# Sağlayıcı özel bir uç nokta kullanıyorsa adresi.
LLM_BASE_URL=
