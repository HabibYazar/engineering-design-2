# Ortam değişkeni şablonu.
#
# Kullanım: bu dosyayı .env adıyla kopyalayın ve gerekirse değerleri değiştirin.
#     cp .env.example .env
#
# .env dosyası .gitignore içindedir ve Git deposuna GİRMEZ.
# Bu şablona GERÇEK bir parola veya anahtar yazmayın.

# --------------------------------------------------------------------------
# Veritabanı
# --------------------------------------------------------------------------
# Boş bırakılırsa uygulama backend klasöründeki SQLite dosyasını kullanır.
DATABASE_URL=

# --------------------------------------------------------------------------
# Akıllı Asistan — YEREL dil modeli
# --------------------------------------------------------------------------
# Model kullanıcının kendi makinesinde Ollama üzerinden çalışır.
# Hiçbir bulut servisine (OpenAI, Gemini, Claude) istek gönderilmez ve
# HİÇBİR API ANAHTARI KULLANILMAZ. Bu yüzden bu dosyada anahtar alanı yoktur.
#
# Kurulum:
#   1) https://ollama.com adresinden Ollama'yı kurun
#   2) ollama pull qwen3.5:9b
#   3) ollama serve   (çoğu kurulumda arka planda kendiliğinden çalışır)
#
# Ollama kapalıysa uygulama ÇALIŞMAYA DEVAM EDER; yalnızca Akıllı Asistan
# ekranı "servise ulaşılamıyor" durumunu gösterir.

# Asistanı tamamen kapatmak için false yapın.
ASSISTANT_ENABLED=true

# Sağlayıcı. Tanımlı tek değer: ollama
LLM_PROVIDER=ollama

# Yerel Ollama sunucusunun adresi.
# UYARI: 127.0.0.1 dışında bir adres yazmak, kurum verisinin makine dışına
# çıkması anlamına gelir.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Kullanılacak model. Bu modelin `ollama pull` ile kurulmuş olması gerekir.
OLLAMA_MODEL=qwen3.5:9b

# Cevap bekleme süresi (saniye). Model ilk çağrıda belleğe yüklenirken
# uzun sürebilir; bu yüzden değer cömert tutuldu.
OLLAMA_TIMEOUT_SECONDS=120

# Modele verilecek bağlam penceresi (token).
OLLAMA_CONTEXT_LENGTH=8192

# Üretim sıcaklığı. Yönetim raporlarında yaratıcılık değil tutarlılık istenir.
OLLAMA_TEMPERATURE=0.2

# Kullanıcı mesajı için üst sınır (karakter).
ASSISTANT_MAX_MESSAGE_LENGTH=4000

# Bellekte tutulacak konuşma sayısı ve konuşma başına mesaj sayısı.
ASSISTANT_MAX_CONVERSATIONS=100
ASSISTANT_MAX_HISTORY_MESSAGES=20
